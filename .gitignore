# === Hermes config + automation repo: DEFAULT-DENY ===
# Ignore everything at the root by default...
/*

# ...then re-include ONLY non-secret config worth versioning.
!/.gitignore
!/config.yaml
!/profile.yaml
!/SOUL.md
!/shell-hooks-allowlist.json
!/context_length_cache.yaml

# cron: descend into dir, but track only the job definitions
!/cron/
/cron/*
!/cron/jobs.json

# === Automation source-of-truth (task t_376ecb33, 2026-07-13) ===
# Track durable automation scripts (the governor/probe fleet substrate).
# Default-deny keeps all secret/runtime material out unless explicitly re-included.
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh
!/scripts/*.md

# Deny scratch / runtime / cache subdirs under scripts/
/scripts/archive/
/scripts/backups/
/scripts/logs/
/scripts/state/
/scripts/.tmp-backups/
/scripts/staging/
/scripts/__pycache__/
/scripts/.pytest_cache/
/scripts/.ruff_cache/

# SECURITY GATE: deny files containing HARDCODED SECRETS.
# These were real credentials committed in source and previously blocked the
# automation version-control commit (runbook t_376ecb33). Remediation task
# t_238b41fd externalized all 5 to env / the existing secret store; they now pass
# the pre-commit secret scan (runbook section 6) and are tracked like other
# automation source. The deny list is kept empty on purpose — see runbook.

# Hooks are part of the automation-source surface. Keep runtime hook logs/state
# denied by the root default-deny unless explicitly re-included here.
!/agent-hooks/
/agent-hooks/*
!/agent-hooks/*

# Profile crontabs (dispatch config) — track ONLY jobs.json, exclude profile runtime/state.
# Re-include chain must keep every ancestor dir non-excluded (git rule).
!/profiles/
/profiles/*
!/profiles/*/
/profiles/*/*
!/profiles/*/cron/
/profiles/*/cron/*
!/profiles/*/cron/jobs.json

# NEVER track (belt-and-suspenders against future allowlist edits):
auth.json
auth.json.*
.env
.env.*
*.db
*.db-*
*.bak
*.bak-*
*.bak.*
