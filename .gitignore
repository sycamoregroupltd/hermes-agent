# === Hermes config + automation repo: DEFAULT-DENY ===
# Ignore everything at the root by default...
/*

# ...then re-include ONLY non-secret config worth versioning.
!/.gitignore
!/config.yaml
!/profile.yaml
!/SOUL.md
!/shell-hooks-allowlist.json
!/context_length_cache.yaml

# cron: descend into dir; jobs.json is LIVE scheduler state and is intentionally
# NOT tracked (t_6c32b13c) — a checkout must never rewrite the running store.
!/cron/
/cron/*

# Sanitized cron-store recovery snapshots (t_6c32b13c completion, 2026-08-05):
# generated by automation_vc_keeper under this NON-LIVE path. The live stores
# above stay untracked; a DGX rebuild recovers job definitions from here.
!/cron-snapshots/

# === Automation source-of-truth (task t_376ecb33, 2026-07-13) ===
# Track durable automation scripts (the governor/probe fleet substrate).
# Default-deny keeps all secret/runtime material out unless explicitly re-included.
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh
!/scripts/*.md

# Regression tests for those scripts are part of the same durable substrate —
# an untracked test cannot gate a future change (task t_e263797e, 2026-08-02).
!/scripts/tests/
!/scripts/tests/*.py
/scripts/tests/__pycache__/

# Cron scripts that live in a SUBDIRECTORY of scripts/ (2026-08-28). The depth-1
# `!/scripts/*.py` above does not match them, so a job pointing at
# scripts/<dir>/<file>.py was silently untracked — untracked-cron-script-guard
# (b94a952f8849) had been failing on exactly this since it was written.
!/scripts/frank-gate-probe/
!/scripts/frank-gate-probe/*.py
!/scripts/frank-gate-probe/*.sh
/scripts/frank-gate-probe/__pycache__/

# Deny scratch / runtime / cache subdirs under scripts/
/scripts/archive/
/scripts/backups/
/scripts/logs/
/scripts/state/
/scripts/.tmp-backups/
/scripts/staging/
/scripts/__pycache__/
/scripts/.pytest_cache/
/scripts/.ruff_cache/

# SECURITY GATE: deny files containing HARDCODED SECRETS.
# These were real credentials committed in source and previously blocked the
# automation version-control commit (runbook t_376ecb33). Remediation task
# t_238b41fd externalized all 5 to env / the existing secret store; they now pass
# the pre-commit secret scan (runbook section 6) and are tracked like other
# automation source. The deny list is kept empty on purpose — see runbook.

# Hooks are part of the automation-source surface. Keep runtime hook logs/state
# denied by the root default-deny unless explicitly re-included here.
!/agent-hooks/
/agent-hooks/*
!/agent-hooks/*

# Profile crontabs — descend into each profile's cron/ dir for the scripts carve-out
# below, but jobs.json (live scheduler state) is intentionally NOT tracked (t_6c32b13c).
# Re-include chain must keep every ancestor dir non-excluded (git rule).
!/profiles/
/profiles/*
!/profiles/*/
/profiles/*/*
!/profiles/*/cron/
/profiles/*/cron/*

# === Profile cron scripts (task t_4b7afeac) ===
# Generic depth-1 carve-out: cron `script` values resolve to the OWNING profile's
# scripts/ dir (hermes-agent/cron/scheduler.py:2328-2346 — there is NO global
# scripts/ fallback), so the automation source that actually runs must be tracked.
# The per-file `!/...` exceptions below were a false-green treadmill (one file at a
# time, silently regressing new jobs); this pattern tracks every depth-1 .py/.sh by
# default and stays self-maintaining. Default-deny is preserved for everything that
# is not executable automation source (.md, notes, __pycache__, state/, secrets).
# Re-include chain keeps every ancestor dir non-excluded (git rule).
!/profiles/*/scripts/
/profiles/*/scripts/*
!/profiles/*/scripts/*.py
!/profiles/*/scripts/*.sh
# Regression guards for the automation source above are part of the deliverable —
# an untracked test is an unenforced test (t_fae47050).
!/profiles/*/scripts/tests/
!/profiles/*/scripts/tests/*.py
/profiles/*/scripts/tests/__pycache__/
# Same depth-1 blind spot as scripts/ above: a cron script in a subdirectory of a
# profile's scripts/ was never re-included, so it stayed untracked (2026-08-28).
!/profiles/*/scripts/frank-gate-probe/
!/profiles/*/scripts/frank-gate-probe/*.py
!/profiles/*/scripts/frank-gate-probe/*.sh
/profiles/*/scripts/frank-gate-probe/__pycache__/
/profiles/*/scripts/__pycache__/
/profiles/*/scripts/state/

# NEVER track (belt-and-suspenders against future allowlist edits):
auth.json
auth.json.*
.env
.env.*
*.db
*.db-*
*.bak
*.bak-*
*.bak.*
